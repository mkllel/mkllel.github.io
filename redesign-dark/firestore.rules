rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // 최초 관리자 부트스트랩용 UID. 이 계정만 admins 컬렉션을 관리할 수 있습니다.
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.uid == 'KtZLKuzl56QzPLiFVRVfovWVapz2';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 관리자 확인용 컬렉션
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isBootstrapAdmin();
    }

    // 블로그는 데이터 조회와 작성 모두 관리자 전용입니다.
    match /blogPosts/{postId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /portfolioProjects/{projectId} {
      allow read: if isAdmin() || resource.data.isPrivate == false;
      allow create, update, delete: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if settingId == 'theme';
      allow create, update: if settingId == 'theme' &&
        isAdmin() &&
        request.resource.data.keys().hasOnly(['accent']) &&
        request.resource.data.accent in ['green', 'blue', 'purple'];
      allow delete: if false;
    }

    // 나머지 문서는 기본 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
